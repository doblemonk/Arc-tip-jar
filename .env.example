# Arc Tip Jar — environment variables.
# Copy this file to .env.local and fill in your own values.
# NEVER commit a real .env.local (it is gitignored). No secrets are in this repo.

# --- Required ---
# Dashboard PIN. This is the PIN that unlocks the creator dashboard,
# the webhook simulator, Test Lab and test-data cleanup.
# If set, it takes precedence over any PIN chosen in the in-app creator setup.
DASHBOARD_PIN=

# --- Upstash Redis (recommended; Vercel Marketplace sets these names) ---
# Create a KV database in the Vercel dashboard (Storage -> Upstash Redis) and attach it
# to this project; Vercel fills these in automatically. Without them the app
# falls back to ephemeral in-memory storage and shows a warning banner —
# donations will NOT survive a redeploy or a cold start.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- River AI (for thank-you messages and copy polishing) ---
# River inference is OpenAI-compatible at https://api.river.ai/v1/chat/completions.
# RIVER_API_KEY is required for LIVE AI calls; without it the app falls back
# to saved defaults that River generated earlier (clearly labelled, never
# presented as a live call). Set it in the Vercel dashboard, never commit it.
# River usage bills the account owner's River account.
RIVER_API_KEY=

# Optional. Default: deepseek-ai/DeepSeek-V4.1-Flash (verified live).
# Do NOT use Qwen/Qwen3.5-9B here: on this endpoint it spends its whole
# token budget on reasoning_content and returns empty content.
RIVER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# --- Circle (optional, only for real Gateway transfer submission) ---
# Without CIRCLE_API_KEY the app is honest about it: burn intents are built
# and signed for real, but POST /v1/transfer is NOT submitted and donations
# stay in "processing" until a webhook (or the simulator / Test Lab)
# finalizes them. No transferId is ever faked as a real one.
# Testnet and mainnet keys are separate — this app is testnet only, so use a
# TESTNET key from the Circle dashboard.
CIRCLE_API_KEY=

# --- Circle webhook signature verification (optional but required in production) ---
# PEM-encoded EC public key used to verify the X-Circle-Signature header
# (ECDSA SHA-256 over the raw request body). Paste the full key including the
# -----BEGIN PUBLIC KEY----- / -----END PUBLIC KEY----- lines, as one line
# with \n for each line break, e.g.:
# CIRCLE_WEBHOOK_SIGNING_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
# If unset, signature verification is SKIPPED and the webhook endpoint logs a
# warning (development mode only — do not publish like that).
CIRCLE_WEBHOOK_SIGNING_KEY=
